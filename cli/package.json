{
  "name": "matrix-bridge-cli",
  "version": "0.2.0",
  "description": "Push text, images and frames to a Phone (3) Glyph Matrix from any terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "matrix": "dist/matrix.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/matrix.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/matrix.js --banner:js=\"#!/usr/bin/env node\" --alias:@matrix-bridge/core=../core/src/index.ts --external:ws --external:bonjour-service --external:pngjs --external:jpeg-js"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0"
  }
}
