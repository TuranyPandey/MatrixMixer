{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatrixMixer",
  "version": "0.2.1",
  "identifier": "io.github.matrixbridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MatrixMixer",
        "width": 1040,
        "height": 700,
        "minWidth": 860,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "island",
        "url": "island.html",
        "title": "MatrixMixer island",
        "width": 250,
        "height": 42,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
